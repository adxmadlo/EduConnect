# EduConnect — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS committer .env sur Git

# Base de données
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=educonnect
DB_PORT=3306

# Wave Business API
# Obtenir depuis : https://wave.com/fr/business/
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Orange Money Business
# Obtenir depuis : https://developer.orange.com/
OM_API_KEY=
OM_MERCHANT_KEY=
OM_WEBHOOK_SECRET=

# Firebase (clés publiques — ok dans le code frontend)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Email (Resend ou SendGrid)
MAIL_API_KEY=
MAIL_FROM=noreply@ucao-saintmichel.sn

# SMS (AfricasTalking)
AT_USERNAME=sandbox
AT_API_KEY=
